@init
gfx_ext_retina = 1;
MAX_WIN = 32768;
MAX_BINCOUNT = 16385;
MOM_HOLD_FLOOR = -70;
MOM_MS = 400;
BAL_TAU_S = 2.5;
BAL_FRAC = 0.19;
BAL_MIN_HZ = 50;
LN22050 = 10.001068;
ENV_INIT = 0.08838834765;
DB_PER_NEPER = 8.68588963807;
NEPER_PER_DB = 0.11512925465;
FLOOR_GAIN = 0.00001;
SC_EPS = 0.00000012;
TIMING_FADE_S = 0.15;

freemem = 0;
hann = freemem; freemem += MAX_WIN;
inbufL = freemem; freemem += MAX_WIN;
inbufR = freemem; freemem += MAX_WIN;
outbufL = freemem; freemem += MAX_WIN;
outbufR = freemem; freemem += MAX_WIN;
fftbufL = freemem; freemem += MAX_WIN;
fftbufR = freemem; freemem += MAX_WIN;
dryringL = freemem; freemem += MAX_WIN;
dryringR = freemem; freemem += MAX_WIN;
scinL = freemem; freemem += MAX_WIN;
scinR = freemem; freemem += MAX_WIN;
lnfreq = freemem; freemem += MAX_BINCOUNT;
downthr = freemem; freemem += MAX_BINCOUNT;
downrr = freemem; freemem += MAX_BINCOUNT;
downkscale = freemem; freemem += MAX_BINCOUNT;
downkint = freemem; freemem += MAX_BINCOUNT;
upthr = freemem; freemem += MAX_BINCOUNT;
uprr = freemem; freemem += MAX_BINCOUNT;
upkscale = freemem; freemem += MAX_BINCOUNT;
upkint = freemem; freemem += MAX_BINCOUNT;
envL = freemem; freemem += MAX_BINCOUNT;
envR = freemem; freemem += MAX_BINCOUNT;
scmagL = freemem; freemem += MAX_BINCOUNT;
scmagR = freemem; freemem += MAX_BINCOUNT;
bininrange = freemem; freemem += MAX_BINCOUNT;
rawgain = freemem; freemem += MAX_BINCOUNT;
dispenv = freemem; freemem += MAX_BINCOUNT;
dispgain = freemem; freemem += MAX_BINCOUNT;
shape_lt = freemem; freemem += MAX_BINCOUNT;
shape_db = freemem; freemem += MAX_BINCOUNT;
shape_cum = freemem; freemem += MAX_BINCOUNT;
smlo = freemem; freemem += MAX_BINCOUNT;
smhi = freemem; freemem += MAX_BINCOUNT;
sweight = freemem; freemem += MAX_BINCOUNT;
b1weight = freemem; freemem += MAX_BINCOUNT;
AN_NB = 24; AN_MAXF = 2600; AN_STRIDE = 32;
an_mem = freemem; freemem += AN_MAXF*AN_STRIDE;
an_Lv = freemem; freemem += AN_MAXF;
an_t1 = freemem; freemem += AN_MAXF;
an_t2 = freemem; freemem += AN_MAXF;
an_vi = freemem; freemem += AN_MAXF;
an_bidx = freemem; freemem += MAX_BINCOUNT;
an_acc = freemem; freemem += 32;
an_cnt = freemem; freemem += 32;
an_fc = freemem; freemem += 32;
an_T = freemem; freemem += 32;
an_Ts = freemem; freemem += 32;
an_Tn = freemem; freemem += 32;
an_D = freemem; freemem += 32;
an_S = freemem; freemem += 32;
an_state = 0; an_req = 0; an_stop = 0; an_ready = 0; an_n = 0; an_msg = 0; an_done_t = -1000; an_target = 940; an_win = 0;

function configure(widx, oidx)
local(i, hw, minb)
(
  win_size = floor(pow(2, widx+6) + 0.5);
  num_bins = win_size*0.5;
  bincount = num_bins + 1;
  overlap = floor(pow(2, oidx+2) + 0.5);
  hop = win_size/overlap;
  first_non_dc_bin = floor(20 / ((srate*0.5)/bincount)) + 1;

  i = 0;
  loop(win_size,
    hann[i] = 0.5 - 0.5*cos(2*$pi*i/(win_size-1));
    inbufL[i] = 0; inbufR[i] = 0;
    outbufL[i] = 0; outbufR[i] = 0;
    dryringL[i] = 0; dryringR[i] = 0;
    scinL[i] = 0; scinR[i] = 0;
    i += 1;
  );

  minb = max(1, floor(BAL_MIN_HZ*win_size/srate + 0.5));
  i = 0;
  loop(bincount,
    lnfreq[i] = i == 0 ? 0 : log(i*srate/win_size);
    envL[i] = ENV_INIT; envR[i] = ENV_INIT;
    scmagL[i] = 0; scmagR[i] = 0;
    rawgain[i] = 0;
    dispenv[i] = ENV_INIT; dispgain[i] = 0;
    shape_lt[i] = 1; shape_db[i] = 0;
    hw = max(minb, floor(i*BAL_FRAC + 0.5));
    smlo[i] = max(0, i-hw); smhi[i] = min(num_bins, i+hw);
    i += 1;
  );

  i = 0;
  loop(win_size, fftbufL[i] = sin(2*$pi*4*i/win_size); i += 1;);
  fft_real(fftbufL, win_size);
  fft_permute(fftbufL, num_bins);
  fft_fwd_scale = sqrt(fftbufL[8]*fftbufL[8] + fftbufL[9]*fftbufL[9]) / (win_size*0.5);

  i = 0;
  loop(win_size, fftbufL[i] = 0; i += 1;);
  fftbufL[0] = 1;
  fft_real(fftbufL, win_size);
  fft_permute(fftbufL, num_bins);
  fft_ipermute(fftbufL, num_bins);
  ifft_real(fftbufL, win_size);
  fft_roundtrip_gain = fftbufL[0];
  i = 0;
  loop(win_size, fftbufL[i] = 0; i += 1;);

  in_gain = sqrt(1 / ((overlap/4) * 1.5 * win_size)) / fft_fwd_scale;
  out_gain = 1 / (in_gain * fft_roundtrip_gain * (overlap/4) * 1.5);

  wpos = 0;
  hop_ctr = 0;
  timing_scale = 0;
  mom_snap = 1;
  lt_n = 1; bal_tick = 0; bal_dirty = 1;
  cur_widx = widx; cur_oidx = oidx;
  force_update = 1;
  s_dirty = 1; s_gdb = 0;
);

function fill_window(dst, src, base)
local(j, idx)
(
  idx = base; j = 0;
  loop(win_size,
    dst[j] = src[idx] * hann[j] * in_gain;
    j += 1; idx += 1;
    idx >= win_size ? idx = 0;
  );
);

function add_output(dst, buf, base)
local(j, idx)
(
  idx = base; j = 0;
  loop(win_size,
    dst[idx] += buf[j] * hann[j] * out_gain;
    j += 1; idx += 1;
    idx >= win_size ? idx = 0;
  );
);

function forward_fft(buf)
(
  fft_real(buf, win_size);
  fft_permute(buf, num_bins);
);

function inverse_fft(buf)
(
  fft_ipermute(buf, num_bins);
  ifft_real(buf, win_size);
);

function store_sc_mags(buf, dst)
local(i, re, im)
(
  dst[0] = abs(buf[0]);
  dst[num_bins] = abs(buf[1]);
  i = 1;
  loop(num_bins-1,
    re = buf[2*i]; im = buf[2*i+1];
    dst[i] = sqrt(re*re + im*im);
    i += 1;
  );
);

function compute_shape_db()
local(i, lo, hi, sum)
(
  shape_cum[0] = shape_lt[0];
  i = 1;
  loop(num_bins, shape_cum[i] = shape_cum[i-1] + shape_lt[i]; i += 1;);
  i = 0;
  loop(bincount,
    lo = smlo[i]; hi = smhi[i];
    sum = lo == 0 ? shape_cum[hi] : shape_cum[hi] - shape_cum[lo-1];
    shape_db[i] = DB_PER_NEPER*log(max(sum/(hi-lo+1), FLOOR_GAIN));
    i += 1;
  );
);

function build_sib_weights()
local(i, f, wx, wt, wl, t, hi)
(
  eff_xover = xover_set; eff_lo = lo_set;
  hi = max(s_hi_set, xover_set*1.5);
  eff_s_hi = hi; eff_s_lo = xover_set;
  s_wsum = 0; s_first = num_bins; s_last = 0;
  i = 0;
  loop(bincount,
    f = max(1, i*srate/win_size);
    // complementary crossover: band 1 = 1-wx, band 2 = wx*top (smoothstep over +-0.2 octave)
    t = max(0, min(1, 0.5 + log(f/xover_set)/log(2)/0.4));
    wx = t*t*(3-2*t);
    // top edge of band 2 rolls off over 0.25 octave
    t = max(0, min(1, 1 + log(hi/f)/log(2)/0.25));
    wt = t*t*(3-2*t);
    t = max(0, min(1, 0.5 + log(f/lo_set)/log(2)/0.4));
    wl = lo_set <= 20.5 ? 1 : t*t*(3-2*t);
    b1weight[i] = (1 - wx)*wl;
    sweight[i] = wx*wt;
    sweight[i] > 0.0001 ? ( s_wsum += sweight[i]; i < s_first ? s_first = i; i > s_last ? s_last = i; );
    i += 1;
  );
  ref_lo = max(1, ceil(200*win_size/srate));
  ref_hi = min(num_bins-1, floor(2500*win_size/srate));
  s_dirty = 0;
);

function compute_sib(eff_sr)
local(i, re, im, m, es, er, et, rdb, over, red, gate_db, gf, tgt, k, rc)
(
  es = 0; er = 0; et = 0;
  i = 1;
  loop(num_bins-1,
    m = (sqr(fftbufL[2*i]) + sqr(fftbufL[2*i+1]) + sqr(fftbufR[2*i]) + sqr(fftbufR[2*i+1]))*0.5;
    et += m;
    es += m*sweight[i];
    i >= ref_lo && i <= ref_hi ? er += m;
    i += 1;
  );
  es /= max(s_wsum, 0.000001);
  er /= max(ref_hi-ref_lo+1, 1);
  et /= (num_bins-1);
  rdb = 10*log10(max(es, 0.00000000000000000001)/max(er, 0.00000000000000000001));
  s_rdb = rdb;
  gate_db = 10*log10(max(et, 0.00000000000000000001)) - mom_db;
  gf = mom_snap ? 0 : max(0, min(1, (gate_db + 20)/8));
  gf = gf*gf*(3-2*gf);

  k = 6;
  over = rdb - s_thr;
  over < -k*0.5 ? over = 0 :
  over < k*0.5 ? over = sqr(over + k*0.5)/(2*k) : over = over;
  red = min(over*(1 - 1/max(1,s_ratio)), s_maxred) * gf;
  tgt = -red;

  rc = exp(-1/(max(1,s_rel_ms)*0.001*eff_sr));
  tgt < s_gdb ? s_gdb = tgt : s_gdb = tgt + (s_gdb - tgt)*rc;
  s_on_eff ? 0 : s_gdb = 0;
);

// ======================= voice analysis ("Analyser la voix") =======================
// Records ~10 s of the input spectrum (24 third-octave bands), then proposes settings.
function an_build_map()
local(i, b, f)
(
  b = 0; loop(AN_NB, an_cnt[b] = 0; an_fc[b] = 80*pow(2, (b+0.5)/3); b += 1;);
  i = 1;
  loop(num_bins-1,
    f = i*srate/win_size;
    b = f >= 80 ? floor(3*log(f/80)/log(2)) : -1;
    (b < 0 || b >= AN_NB) ? ( b = -1; );
    an_bidx[i] = b;
    b >= 0 ? ( an_cnt[b] += 1; );
    i += 1;
  );
);

function an_start()
(
  an_win = win_size;
  an_build_map();
  an_n = 0; an_ready = 0; an_msg = 0; an_state = 1;
  an_target = min(floor(10*srate/hop), AN_MAXF);
);

function an_record()
local(i, b, base, lev)
(
  b = 0; loop(AN_NB, an_acc[b] = 0; b += 1;);
  i = 1;
  loop(num_bins-1,
    b = an_bidx[i];
    b >= 0 ? ( an_acc[b] += (sqr(fftbufL[2*i]) + sqr(fftbufL[2*i+1]) + sqr(fftbufR[2*i]) + sqr(fftbufR[2*i+1]))*0.5; );
    i += 1;
  );
  base = an_mem + an_n*AN_STRIDE; lev = 0;
  b = 0;
  loop(AN_NB,
    an_cnt[b] > 0 ? (
      lev += an_acc[b];
      base[b] = 10*log10(max(an_acc[b]/an_cnt[b], 0.00000000000000000001));
    ) : ( base[b] = -200; );
    b += 1;
  );
  an_Lv[an_n] = 10*log10(max(lev, 0.00000000000000000001));
  an_n += 1;
  (an_n >= an_target || an_n >= AN_MAXF) ? ( an_ready = 1; );
);

function an_sort(base, n)
local(gap, i, j, tmp)
(
  gap = floor(n/2);
  while (gap > 0) (
    i = gap;
    while (i < n) (
      tmp = base[i]; j = i;
      while (j >= gap && base[j-gap] > tmp) ( base[j] = base[j-gap]; j -= gap; );
      base[j] = tmp;
      i += 1;
    );
    gap = floor(gap/2);
  );
);
function an_pct(base, n, p) ( base[floor(p*(n-1) + 0.5)]; );

function an_finalize()
local(n, i, b, j, nv, p90, base, sh, sr_, t88, t50, nS, nN, pk, bp, half, lo, hi, xo, en, y0, y1, tt, c, num, den, cn, cd,
      p50, p95, d, sx, sy, sxx, sxy, nn, x, sl, eqv, res, dev, sm, ns, tmax, fl, compv, startv)
(
  n = an_n;
  i = 0; loop(n, an_t1[i] = an_Lv[i]; i += 1;);
  an_sort(an_t1, n);
  p90 = an_pct(an_t1, n, 0.9);
  nv = 0; i = 0;
  loop(n, an_Lv[i] >= p90 - 18 ? ( an_vi[nv] = i; nv += 1; ); i += 1;);
  nv*hop/srate < 2 ? ( an_state = 4; an_msg = 1; ) : (
    // long-term spectrum + sibilance score of every voiced frame
    b = 0; loop(AN_NB, an_T[b] = 0; an_Ts[b] = 0; an_Tn[b] = 0; b += 1;);
    i = 0;
    loop(nv,
      base = an_mem + an_vi[i]*AN_STRIDE;
      sh = 0; sr_ = 0; b = 0;
      loop(AN_NB,
        an_cnt[b] > 0 ? (
          c = pow(10, base[b]/10);
          an_T[b] += c;
          (an_fc[b] >= 3500 && an_fc[b] < 12000) ? ( sh += c*an_cnt[b]; );
          (an_fc[b] >= 200 && an_fc[b] < 2500) ? ( sr_ += c*an_cnt[b]; );
        );
        b += 1;
      );
      an_t2[i] = 10*log10(max(sh, 0.00000000000000000001)/max(sr_, 0.00000000000000000001));
      an_t1[i] = an_t2[i];
      i += 1;
    );
    b = 0; loop(AN_NB, an_cnt[b] > 0 ? ( an_T[b] = 10*log10(max(an_T[b]/nv, 0.00000000000000000001)); ); b += 1;);
    an_sort(an_t1, nv);
    t88 = an_pct(an_t1, nv, 0.88); t50 = an_pct(an_t1, nv, 0.5);
    // average spectrum of the sibilant frames vs. the others
    nS = 0; nN = 0; i = 0;
    loop(nv,
      base = an_mem + an_vi[i]*AN_STRIDE;
      an_t2[i] >= t88 ? ( nS += 1; b = 0; loop(AN_NB, an_cnt[b] > 0 ? ( an_Ts[b] += pow(10, base[b]/10); ); b += 1;); );
      an_t2[i] <= t50 ? ( nN += 1; b = 0; loop(AN_NB, an_cnt[b] > 0 ? ( an_Tn[b] += pow(10, base[b]/10); ); b += 1;); );
      i += 1;
    );
    b = 0;
    loop(AN_NB,
      an_D[b] = an_cnt[b] > 0 ? 10*log10(max(an_Ts[b]/max(nS,1), 0.00000000000000000001)) - 10*log10(max(an_Tn[b]/max(nN,1), 0.00000000000000000001)) : 0;
      b += 1;
    );
    b = 0;
    loop(AN_NB,
      sm = 0; ns = 0; j = max(0, b-1);
      loop(min(AN_NB-1, b+1) - j + 1, an_cnt[j] > 0 ? ( sm += an_D[j]; ns += 1; ); j += 1;);
      an_S[b] = ns > 0 ? sm/ns : 0;
      b += 1;
    );
    // where do the sibilants stand out? (half height of the difference curve)
    bp = -1; pk = -1000; b = 0;
    loop(AN_NB, (an_cnt[b] > 0 && an_fc[b] >= 2500 && an_fc[b] < 14000 && an_S[b] > pk) ? ( pk = an_S[b]; bp = b; ); b += 1;);
    an_msg = 0;
    (bp < 0 || pk < 6) ? (
      xo = 4200; en = 9500; an_msg = 2;
    ) : (
      half = pk*0.5;
      lo = bp; while (lo > 0 && an_S[lo] > half && an_fc[lo] > 1500) ( lo -= 1; );
      (lo == bp) ? ( xo = an_fc[bp]; ) : (
        (an_S[lo] > half) ? ( xo = an_fc[lo]; ) : (
          y0 = an_S[lo+1] - half; y1 = an_S[lo] - half; tt = y0/max(y0 - y1, 0.0001);
          xo = an_fc[lo+1]*pow(an_fc[lo]/an_fc[lo+1], tt);
        );
      );
      hi = bp; while (hi < AN_NB-1 && an_S[hi] > half) ( hi += 1; );
      (an_S[hi] > half) ? ( en = 12000; ) : (
        y0 = an_S[hi-1] - half; y1 = an_S[hi] - half; tt = y0/max(y0 - y1, 0.0001);
        en = an_fc[hi-1]*pow(an_fc[hi]/an_fc[hi-1], tt);
      );
      xo = max(2500, min(8000, xo));
      en = min(12000, max(max(7000, xo*1.5), en));
    );
    xo = floor(xo + 0.5); en = floor(en + 0.5);
    // sibilance excess in that band -> de-essing amount
    i = 0;
    loop(nv,
      base = an_mem + an_vi[i]*AN_STRIDE;
      num = 0; den = 0; cn = 0; cd = 0; b = 0;
      loop(AN_NB,
        an_cnt[b] > 0 ? (
          c = pow(10, base[b]/10);
          (an_fc[b] >= xo && an_fc[b] < en) ? ( num += c*an_cnt[b]; cn += an_cnt[b]; );
          (an_fc[b] >= 200 && an_fc[b] < 2500) ? ( den += c*an_cnt[b]; cd += an_cnt[b]; );
        );
        b += 1;
      );
      an_t1[i] = 10*log10(max(num/max(cn,1), 0.00000000000000000001)/max(den/max(cd,1), 0.00000000000000000001));
      i += 1;
    );
    an_sort(an_t1, nv);
    p50 = an_pct(an_t1, nv, 0.5);
    i = floor(0.92*(nv-1)); p95 = 0; nn = 0;
    loop(nv - i, p95 += an_t1[i]; nn += 1; i += 1;);
    p95 = p95/max(nn, 1);
    d = max(0, min(1, (p95 + 3)/15));
    (p95 - p50) < 4 ? ( d = min(d, 0.25); );
    // tonal balance (slope in dB/octave between 500 Hz and 8 kHz)
    sx = 0; sy = 0; sxx = 0; sxy = 0; nn = 0; b = 0;
    loop(AN_NB,
      (an_cnt[b] > 0 && an_fc[b] >= 500 && an_fc[b] < 8000) ? (
        x = log(an_fc[b])/log(2);
        sx += x; sy += an_T[b]; sxx += x*x; sxy += x*an_T[b]; nn += 1;
      );
      b += 1;
    );
    sl = (nn*sxy - sx*sy)/max(nn*sxx - sx*sx, 0.0001);
    eqv = max(-5, min(8, 1.9 - 1.2*(sl + 7.5)));
    // unevenness of the average spectrum (peaks above their surroundings)
    res = 0; b = 0;
    loop(AN_NB,
      (an_cnt[b] > 0 && an_fc[b] >= 250 && an_fc[b] < 4000) ? (
