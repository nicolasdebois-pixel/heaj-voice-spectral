);

is_playing ? (
  gfx_dest = IMG_SCOPE;
  gfx_mode = 0;
  gfx_set(GBG_R, GBG_G, GBG_B, 1 - exp(-gfx_dt/0.25));
  gfx_rect(0, 0, graph_w, graph_h, 1);

  gstride = max(1, floor(num_bins/2048));
  bi = 1;
  loop(floor((num_bins-1)/gstride),
    binfreq = bi*srate/win_size;
    nextbinfreq = (bi+gstride)*srate/win_size;
    binfreq >= MIN_FREQ && binfreq <= MAX_FREQ ? (
      sx = graph_w * log(binfreq/MIN_FREQ) / FREQ_LOG_SPAN;
      sx2 = graph_w * log(min(MAX_FREQ,nextbinfreq)/MIN_FREQ) / FREQ_LOG_SPAN;
      bw = max(1*scale, sx2-sx);
      gdb = dispgain[bi];
      sy = graph_h*0.5*(1 - max(-GAIN_DB_RANGE,min(GAIN_DB_RANGE,gdb))/GAIN_DB_RANGE);
      scy = graph_h*0.5;
      pk = max(0, min(1, abs(gdb)/GAIN_DB_RANGE));
      pk > 0.001 ? (
        sweight[bi] > 0.5 ? gfx_set(C_CY_R, C_CY_G, C_CY_B, 0.50 + 0.45*pk) : gfx_set(C_RED_R, C_RED_G, C_RED_B, 0.45 + 0.5*pk);
        by0 = min(sy, scy); by1 = max(sy, scy);
        gfx_rect(sx, by0, bw, max(1,by1-by0), 1);
      );
    );
    bi += gstride;
  );
  gfx_dest = -1;
);

gfx_dest=-1; gfx_a=1; gfx_mode=1;
gfx_x=graph_x0; gfx_y=graph_y0;
gfx_blit(IMG_SCOPE,1,0);
gfx_mode=0;

is_playing ? ( stop_fade = 0; ) : ( stop_fade = min(1, stop_fade + 0.015); );
stop_fade > 0 ? (
  gfx_set(GBG_R, GBG_G, GBG_B, stop_fade*0.94);
  gfx_rect(graph_x0, graph_y0, graph_w, graph_h, 1);
);

// band regions
lo_x = freq_to_gx(eff_lo);
xo_x = freq_to_gx(eff_xover);
hi_x = freq_to_gx(eff_s_hi);
gfx_set(C_RED_R, C_RED_G, C_RED_B, comp_ui ? 0.05 : 0.015);
gfx_rect(lo_x, graph_y0, xo_x - lo_x, graph_h, 1);
gfx_set(C_CY_R, C_CY_G, C_CY_B, (s_on_eff || (simple_g && !des_ui)) ? (des_ui ? 0.06 : 0.015) : 0.015);
gfx_rect(xo_x, graph_y0, hi_x - xo_x, graph_h, 1);

draw_graph_axes(!simple_g);
is_playing ? draw_level_spectrum();
!simple_g ? draw_target_curve();

gfx_set(1, 1, 1, 0.10);
gfx_roundrect(graph_x0, graph_y0, graph_w, graph_h, 8*scale, 1);

// band captions
gfx_setfont(1, "Arial", 11*scale, 'b');
gfx_set(C_RED_R, 0.50, 0.46, 0.95);
gfx_measurestr("BANDE 1 · VOIX", t1w, t1h);
(xo_x - lo_x) > t1w + 16*scale ? ( gfx_x = lo_x + 10*scale; gfx_y = graph_y1 - t1h - 8*scale; gfx_drawstr("BANDE 1 · VOIX"); );
gfx_set(C_CY_R, C_CY_G, C_CY_B, 0.95);
gfx_measurestr("BANDE 2 · SIFFLANTES", t2w, t2h);
(hi_x - xo_x) > t2w + 16*scale ? ( gfx_x = xo_x + 10*scale; gfx_y = graph_y1 - t2h - 8*scale; gfx_drawstr("BANDE 2 · SIFFLANTES"); ) : (
  gfx_measurestr("BANDE 2", t2w, t2h);
  (hi_x - xo_x) > t2w + 14*scale ? ( gfx_x = xo_x + 8*scale; gfx_y = graph_y1 - t2h - 8*scale; gfx_drawstr("BANDE 2"); );
);
// live de-ess reduction
s_on_eff ? (
  gfx_setfont(1, "Arial", 12*scale, 'b');
  gfx_set(C_CY_R, C_CY_G, C_CY_B, 1);
  sprintf(#grtxt, "%.1f dB", s_gdb);
  gfx_measurestr(#grtxt, gw, gh);
  gfx_x = hi_x - gw - 10*scale; gfx_y = graph_y0 + 8*scale;
  gfx_drawstr(#grtxt);
);

// handles: start of band 1, crossover, end of band 2
fmt_freq(eff_lo); sprintf(#hs, "Début  %s", #fstr);
handle(lo_x, #hs, 0, 0, C_RED_R, C_RED_G, C_RED_B);
h1x = hd_x; h1y = hd_y; h1w = hd_w; h1h = hd_h;
fmt_freq(eff_xover); sprintf(#hs, "Crossover  %s", #fstr);
handle(xo_x, #hs, 1, 0, C_TX_R, C_TX_G, C_TX_B);
h2x = hd_x; h2y = hd_y; h2w = hd_w; h2h = hd_h;
fmt_freq(eff_s_hi); sprintf(#hs, "Fin  %s", #fstr);
handle(hi_x, #hs, (hi_x + 140*scale > gc_x + gc_w) ? 1 : 0, 0, C_CY_R, C_CY_G, C_CY_B);
h3x = hd_x; h3y = hd_y; h3w = hd_w; h3h = hd_h;

// footer credit
gfx_setfont(1, "Arial", 10*scale);
gfx_set(C_MU_R, C_MU_G, C_MU_B, 0.65);
gfx_x = MARGIN; gfx_y = gfx_h - 16*scale;
gfx_drawstr("Moteur : Intelligent Spectral Compressor (chmaha), d'après Spectral Compressor (R. van der Helm) · GPLv3+");

// ---------- interaction ----------
HIT = 9*scale;
mouse_just_down && drag_target == 0 ? (
  hh = 0;
  (hit_rect(mouse_x, mouse_y, h2x, h2y, h2w, h2h) || (mouse_y >= graph_y0 && mouse_y <= graph_y1 && abs(mouse_x - xo_x) <= HIT)) ? hh = 100 :
  (hit_rect(mouse_x, mouse_y, h3x, h3y, h3w, h3h) || (mouse_y >= graph_y0 && mouse_y <= graph_y1 && abs(mouse_x - hi_x) <= HIT)) ? hh = 101 :
  (hit_rect(mouse_x, mouse_y, h1x, h1y, h1w, h1h) || (mouse_y >= graph_y0 && mouse_y <= graph_y1 && abs(mouse_x - lo_x) <= HIT)) ? hh = 102;
  hh > 0 ? (
    (click_target == hh && time_precise() - click_time < 0.3) ? (
      hh == 100 ? ( slider22 = 4200; slider_automate(slider22); ) :
      hh == 101 ? ( slider29 = 9500; slider_automate(slider29); ) :
                  ( slider21 = 20; slider_automate(slider21); );
    ) : ( drag_target = hh; );
    click_target = hh; click_time = time_precise();
  );
);
drag_target == 100 && mouse_down ? (
  slider22 = max(max(1000, slider21*1.5), min(min(12000, slider29/1.5), gx_to_freq(mouse_x))); slider_automate(slider22);
);
drag_target == 101 && mouse_down ? (
  slider29 = max(max(3000, slider22*1.5), min(20000, gx_to_freq(mouse_x))); slider_automate(slider29);
);
drag_target == 102 && mouse_down ? (
  slider21 = max(20, min(min(2000, slider22/1.5), gx_to_freq(mouse_x))); slider_automate(slider21);
);

pw_hit == 1 ? ( slider35 = comp_ui ? 0 : 1; slider_automate(slider35); );
pw_hit == 2 ? ( slider36 = des_ui ? 0 : 1; slider_automate(slider36); );
pw_hit == 3 ? ( slider37 = eq_ui ? 0 : 1; slider_automate(slider37); );

simple_g && mouse_just_down && hit_rect(mouse_x, mouse_y, an_bx, an_by, an_bw, an_bh) ? (
  an_state == 1 ? ( an_stop = 1; ) : ( an_req = 1; );
);
mouse_just_down && hit_rect(mouse_x, mouse_y, vw_x, vw_y, vw_w, vw_h) ? (
  slider25 = (view_g + 1) % 3; slider_automate(slider25);
);
!simple_g && mouse_just_down && hit_rect(mouse_x, mouse_y, ds_x, ds_y, ds_w, ds_h) ? (
  slider28 = s_on_eff ? 0 : 1; slider_automate(slider28);
);
!simple_g && mouse_just_down && adv_view && g_mode == 0 && hit_rect(mouse_x, mouse_y, at_x, at_y, at_w, at_h) ? (
  slider23 = auto_eff ? 0 : 1; slider_automate(slider23);
);
!simple_g && mouse_just_down && auto_eff && hit_rect(mouse_x, mouse_y, ab_x, ab_y, ab_w, ab_h) ? (
  slider24 = bal_eff ? 0 : 1; slider_automate(slider24);
);

drag_target > 0 && drag_target < 100 && mouse_down ? (
  load_knob(drag_target);
  newpos = max(0, min(1, (mouse_x + drag_off - drag_x0) / drag_w));
  drag_val = taper_val(newpos, k_min, k_max, k_log);
  k_step > 0 ? drag_val = k_min + floor((drag_val - k_min)/k_step + 0.5)*k_step;
  store_knob(drag_target, drag_val);
);

!mouse_down ? drag_target = 0;
mouse_state = mouse_down;
