MIN_FREQ = 20; MAX_FREQ = 20000;
GAIN_DB_RANGE = 18;
LEVEL_DB_MIN = -90; LEVEL_DB_MAX = 20;
FREQ_LOG_SPAN = log(MAX_FREQ/MIN_FREQ);

function freq_to_gx(freq) ( graph_x0 + (graph_w * log(max(MIN_FREQ,freq)/MIN_FREQ) / FREQ_LOG_SPAN); );
function gx_to_freq(x) ( max(MIN_FREQ, min(MAX_FREQ, MIN_FREQ*exp(FREQ_LOG_SPAN*(x-graph_x0)/graph_w))); );
function gaindb_to_gy(db) ( graph_y0 + graph_h*0.5*(1 - max(-GAIN_DB_RANGE,min(GAIN_DB_RANGE,db))/GAIN_DB_RANGE); );
function level_to_gy(db) ( graph_y0 + graph_h*(1 - (max(LEVEL_DB_MIN,min(LEVEL_DB_MAX,db))-LEVEL_DB_MIN)/(LEVEL_DB_MAX-LEVEL_DB_MIN)); );

function smooth_display(dt)
local(i, a, tau)
(
  tau = max(0.005, hop/srate*0.5);
  a = 1 - exp(-dt/tau);
  i = 0;
  loop(bincount,
    dispenv[i] += ((envL[i] + envR[i])*0.5 - dispenv[i]) * a;
    dispgain[i] += (rawgain[i] - dispgain[i]) * a;
    i += 1;
  );
);

// spectrum: soft fill + crisp line
function draw_level_spectrum()
local(bi, binfreq, gx, gy, env_db, first, last_gx, last_gy, last_col, col, dense)
(
  dense = num_bins > 2048;
  first = 1; last_col = -1; last_gx = graph_x0; last_gy = graph_y1;
  bi = 1;
  loop(num_bins-1,
    binfreq = bi*srate/win_size;
    (binfreq >= MIN_FREQ && binfreq <= MAX_FREQ) ? (
      gx = freq_to_gx(binfreq);
      col = floor(gx);
      (!dense || col != last_col) ? (
        last_col = col;
        env_db = 20*log(max(dispenv[bi], 0.000000000001))/log(10);
        gy = level_to_gy(env_db);
        first ? ( last_gx = gx; last_gy = gy; first = 0; );
        gfx_set(C_TX_R, C_TX_G, C_TX_B, 0.07);
        gfx_rect(last_gx, min(gy, last_gy), max(1, gx - last_gx + 1), graph_y1 - min(gy, last_gy), 1);
        gfx_set(C_TX_R, C_TX_G, C_TX_B, 0.85);
        gfx_line(last_gx, last_gy, gx, gy, 1);
        last_gx = gx; last_gy = gy;
      );
    );
    bi += 1;
  );
);

function draw_graph_axes(show_levels)
local(fi, ftick, fx, dbtick, dgy, tw, th)
(
  fi = 0;
  loop(10,
    ftick = fi==0?20:fi==1?50:fi==2?100:fi==3?200:fi==4?500:fi==5?1000:fi==6?2000:fi==7?5000:fi==8?10000:20000;
    fx = freq_to_gx(ftick);
    gfx_set(1, 1, 1, 0.045);
    gfx_line(fx, graph_y0, fx, graph_y1, 0);
    ftick < 1000 ? sprintf(#axtxt, "%d", ftick) : sprintf(#axtxt, "%dk", ftick*0.001);
    gfx_setfont(1, "Arial", 11*scale);
    gfx_set(C_MU_R, C_MU_G, C_MU_B, 0.85);
    gfx_measurestr(#axtxt, tw, th);
    gfx_x = min(max(fx - tw*0.5, graph_x0), graph_x1 - tw); gfx_y = graph_y1 + 5*scale;
    gfx_drawstr(#axtxt);
    fi += 1;
  );

  gfx_setfont(1, "Arial", 11*scale);
  dbtick = -GAIN_DB_RANGE + 6;
  while (
    dgy = gaindb_to_gy(dbtick);
    gfx_set(1, 1, 1, dbtick == 0 ? 0.13 : 0.045);
    gfx_line(graph_x0, dgy, graph_x1, dgy, 0);
    show_levels ? (
      sprintf(#axtxt, "%+d", dbtick);
      gfx_set(C_MU_R, C_MU_G, C_MU_B, 0.8);
      gfx_measurestr(#axtxt, tw, th);
      gfx_x = graph_x0 + 5*scale; gfx_y = dgy - th - 1*scale;
      gfx_drawstr(#axtxt);
    );
    dbtick += 6;
    dbtick < GAIN_DB_RANGE;
  );

  show_levels ? (
    dbtick = ceil(LEVEL_DB_MIN/20)*20 + 20;
    while (
      dgy = level_to_gy(dbtick);
      sprintf(#axtxt, "%+d", dbtick);
      gfx_set(C_TX_R, C_TX_G, C_TX_B, 0.40);
      gfx_measurestr(#axtxt, tw, th);
      gfx_x = graph_x1 - tw - 5*scale; gfx_y = dgy - th - 1*scale;
      gfx_drawstr(#axtxt);
      dbtick += 20;
      dbtick < LEVEL_DB_MAX;
    );
  );
);

function draw_target_curve()
local(pass, offs, npts, pi, freq, x, thr, gx, gy, first, side, prev_side)
(
  pass = 0;
  loop(2,
    offs = pass == 0 ? u_off : d_off;
    pass == 0 ? gfx_set(C_CY_R, C_CY_G, C_CY_B, 0.5) : gfx_set(1.0, 0.62, 0.55, 0.8);
    first = 1;
    prev_side = 0;
    npts = 300;
    pi = 0;
    loop(npts+1,
      freq = MIN_FREQ * exp(FREQ_LOG_SPAN * pi/npts);
      x = log(freq) - ln_center;
      thr = thr_disp + slope_eff*x + curve_c*x*x + offs;
      bal_eff ? thr += shape_db[min(num_bins, floor(freq*win_size/srate + 0.5))];
      side = thr > LEVEL_DB_MAX ? 1 : thr < LEVEL_DB_MIN ? -1 : 0;
      gx = freq_to_gx(freq);
      gy = level_to_gy(thr);
      first ? (
        gfx_x = gx; gfx_y = gy; first = 0;
      ) : (
        (side != 0 && side == prev_side) ? (
          gfx_x = gx; gfx_y = gy;
        ) : (
          gfx_lineto(gx, gy, 1);
        );
      );
      prev_side = side;
      pi += 1;
    );
    pass += 1;
  );
);

